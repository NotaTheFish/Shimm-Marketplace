    "@shimm/database": "workspace:*",
    "@shimm/logger": "workspace:*",
    "@shimm/shared-types": "workspace:*",
    "@prisma/client": "^6.3.0",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
